<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010"
    android:orientation="vertical">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E1E1E"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Disconnetti"
            android:textColor="#FF5252"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Desktop Remoto (Mac)"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKeyboard"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tastiera"
            android:textColor="#00E676"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Zona Superiore: Player Video (Aspect Fit - No Crop) -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:background="#000000">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/surfaceViewRenderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Loading Overlay -->
        <LinearLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EE121212"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/loadingProgressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Inizializzazione connessione WebRTC..."
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLoadingDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="In attesa dell'offerta SDP dal Mac..."
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCancelLoading"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Annulla ed Esci"
                android:textColor="@color/text_white" />
        </LinearLayout>
    </FrameLayout>

    <!-- Zona Inferiore: Touchpad Dedicato + Pulsanti Fisici Mouse -->
    <LinearLayout
        android:id="@+id/trackpadContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:background="#161616"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Area Touchpad Rettangolare Scura -->
        <FrameLayout
            android:id="@+id/touchpadArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#202020">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="12dp"
                android:text="Area Touchpad\nTrascina per muovere • Tocco per click • 2 dita scroll/tasto dx"
                android:textColor="#55FFFFFF"
                android:textSize="12sp" />
        </FrameLayout>

        <!-- Pulsanti Fisici Click Sinistro / Click Destro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeftClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#2C2C2C"
                android:text="Click Sinistro"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRightClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#2C2C2C"
                android:text="Click Destro"
                android:textColor="@color/text_white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
